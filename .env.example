# Supabase: Project Settings → API (ou criadas pela integração da Vercel).
# A chave publicável só lê produtos ativos (RLS). Nunca coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Só para o script `npm run imagens` (sobe as fotos). Fica APENAS no seu
# .env.local: nunca na Vercel, nunca no git. Ignora a segurança do banco.
# Supabase → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_xxx
